# Copy this file to .env before running `docker compose up --build`.
# None of these values are real secrets — replace them for anything beyond local/demo use.

# --- backend -----------------------------------------------------------
JWT_SECRET=dev-insecure-secret-change-me
CORS_ORIGIN=*
ADMIN_EMAIL=admin@askvuz.local
ADMIN_PASSWORD=admin12345
SEED_ON_START=true
FAST_RESPONSE_THRESHOLD_SECONDS=300

# --- MAX integration -----------------------------------------------------
# MOCK_MAX=true (default) disables real calls to the MAX Bot API and mirrors
# every outbound message to logs + the browser Chat Simulator instead, so the
# whole scenario can be reviewed without a live token. Ограничения, п.10.
MOCK_MAX=true
# Provide these once the hackathon organizers issue a real bot token, then set
# MOCK_MAX=false. Never commit real values here (Ограничения, п.8).
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://botapi.max.ru
MAX_WEBHOOK_SECRET=

# --- frontend --------------------------------------------------------------
# Base URL the browser uses to reach the backend API/WebSocket.
PUBLIC_API_BASE=http://localhost:4000
